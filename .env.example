# Contoh variabel lingkungan untuk Kenari Usage.
# Salin file ini menjadi .env lalu isi nilai asli. JANGAN commit file .env.
#
# Env var ini bersifat OPSIONAL dan hanya untuk pengembangan.
# Di aplikasi rilis, API key disimpan di OS keyring (Windows Credential Manager)
# lewat halaman Pengaturan. Bila KENARI_API_KEY diset, nilai ini diprioritaskan
# di atas key yang tersimpan di keyring.

KENARI_API_KEY=kn-...
